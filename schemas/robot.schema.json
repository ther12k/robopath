{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robo-paths.invalid/schemas/robot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "enum": [
        "pip",
        "mochi",
        "bolt",
        "sprout"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "starter": {
      "const": true
    },
    "cosmeticOnly": {
      "const": true
    },
    "assetSet": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "starter",
    "cosmeticOnly",
    "assetSet"
  ]
}
