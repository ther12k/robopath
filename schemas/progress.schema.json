{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robo-paths.invalid/schemas/progress.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "const": "robo-paths"
    },
    "schemaVersion": {
      "const": 1
    },
    "engineRulesVersion": {
      "const": 1
    },
    "profileId": {
      "const": "local"
    },
    "selectedRobotId": {
      "enum": [
        "pip",
        "mochi",
        "bolt",
        "sprout"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soundEnabled": {
          "type": "boolean"
        },
        "musicEnabled": {
          "type": "boolean"
        },
        "motion": {
          "enum": [
            "system",
            "reduced",
            "full"
          ]
        },
        "locale": {
          "const": "en"
        }
      },
      "required": [
        "soundEnabled",
        "musicEnabled",
        "motion",
        "locale"
      ]
    },
    "levels": {
      "type": "object",
      "maxProperties": 60,
      "propertyNames": {
        "pattern": "^w[1-4]-[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "levelRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "awards": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "completion": {
                "type": "boolean"
              },
              "bonus": {
                "type": "boolean"
              },
              "efficiency": {
                "type": "boolean"
              }
            },
            "required": [
              "completion",
              "bonus",
              "efficiency"
            ]
          },
          "bestBlocks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "bestActions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          }
        },
        "required": [
          "levelRevision",
          "awards",
          "bestBlocks",
          "bestActions"
        ]
      }
    },
    "drafts": {
      "type": "object",
      "maxProperties": 60,
      "propertyNames": {
        "pattern": "^w[1-4]-[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "levelRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "draft": {
            "$ref": "draft.schema.json"
          }
        },
        "required": [
          "levelRevision",
          "draft"
        ]
      }
    },
    "tutorialsSeen": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "ownedCosmetics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "equippedAccent": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    }
  },
  "required": [
    "app",
    "schemaVersion",
    "engineRulesVersion",
    "profileId",
    "selectedRobotId",
    "settings",
    "levels",
    "drafts",
    "tutorialsSeen",
    "ownedCosmetics",
    "equippedAccent"
  ]
}
