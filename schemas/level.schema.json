{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robo-paths.invalid/schemas/level.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "engineRulesVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^w[1-4]-[0-9]{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "worldId": {
      "enum": [
        "w1",
        "w2",
        "w3",
        "w4"
      ]
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "titleKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "tiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "minItems": 2,
          "maxItems": 64
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "width",
        "height",
        "tiles",
        "walls"
      ]
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "facing": {
          "enum": [
            "N",
            "E",
            "S",
            "W"
          ]
        }
      },
      "required": [
        "x",
        "y",
        "facing"
      ]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "collectibles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "kind": {
            "enum": [
              "required",
              "bonus"
            ]
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "kind"
        ]
      },
      "minItems": 0,
      "maxItems": 8
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        },
        "required": [
          "id",
          "x",
          "y"
        ]
      },
      "minItems": 0,
      "maxItems": 8
    },
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "opens": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "opens"
        ]
      },
      "minItems": 0,
      "maxItems": 8
    },
    "commands": {
      "type": "array",
      "items": {
        "enum": [
          "forward",
          "left",
          "right",
          "repeat"
        ]
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBlocks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "maxActions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "required": [
        "maxBlocks",
        "maxActions"
      ]
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parBlocks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      },
      "required": [
        "parBlocks"
      ]
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "archetype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "concept",
        "archetype",
        "difficulty"
      ]
    },
    "hintKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "required": [
    "schemaVersion",
    "engineRulesVersion",
    "id",
    "revision",
    "worldId",
    "ordinal",
    "titleKey",
    "board",
    "start",
    "goal",
    "collectibles",
    "gates",
    "switches",
    "commands",
    "limits",
    "rating",
    "teaching",
    "hintKeys"
  ]
}
